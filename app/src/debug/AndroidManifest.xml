<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">
        <!-- Debug builds only: lets adb stand in for the Bluetooth radio when testing trip groups on an emulator,
             and lets the old-maps and Strava tests point the app at a plain-HTTP mock server on the host.
             Only the shell (adb) and the system hold DUMP, so no other app on the phone can send these commands. -->
        <receiver
            android:name="com.trailmind.app.debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>

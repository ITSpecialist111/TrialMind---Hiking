      <trkpt lat="51.725742" lon="-2.531670"><ele>15.2</ele></trkpt>
      <trkpt lat="51.726153" lon="-2.531792"><ele>14.8</ele></trkpt>
      <trkpt lat="51.726274" lon="-2.531852"><ele>14.8</ele></trkpt>
      <trkpt lat="51.726183" lon="-2.532322"><ele>17.2</ele></trkpt>
      <trkpt lat="51.726171" lon="-2.532378"><ele>17.5</ele></trkpt>
      <trkpt lat="51.726136" lon="-2.532493"><ele>17.8</ele></trkpt>
      <trkpt lat="51.726045" lon="-2.532746"><ele>18.8</ele></trkpt>
      <trkpt lat="51.725947" lon="-2.532676"><ele>18.2</ele></trkpt>
      <trkpt lat="51.726045" lon="-2.532746"><ele>18.8</ele></trkpt>
      <trkpt lat="51.726136" lon="-2.532493"><ele>17.8</ele></trkpt>
      <trkpt lat="51.726171" lon="-2.532378"><ele>17.5</ele></trkpt>
      <trkpt lat="51.726183" lon="-2.532322"><ele>17.2</ele></trkpt>
      <trkpt lat="51.726274" lon="-2.531852"><ele>14.8</ele></trkpt>
